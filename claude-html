#!/bin/bash
# Rebuild the conversation pages, and open the index when asked for all of them.
set -uo pipefail

# This is normally reached through a symlink on PATH, so follow it back to the
# clone rather than assuming where that is.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
HERE="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# The JavaScript runs through whichever engine is here: osascript on macOS,
# node anywhere else. Same files, same bytes out.
if [ -z "${CLAUDE_HTML_FORCE_NODE:-}" ] && command -v osascript >/dev/null 2>&1; then
  run_js() { osascript -l JavaScript "$@"; }; MAC=true
else
  run_js() { node "$@"; }; MAC=false
fi

# Where install.sh was told things live; an environment variable wins.
CONF="${CLAUDE_HTML_CONF:-$HOME/.claude/claude-html.conf}"
_env_root="${CLAUDE_HTML_ROOT:-}"
_env_out="${CLAUDE_HTML_OUT:-}"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"
ROOT="${_env_root:-${CLAUDE_HTML_ROOT:-$HOME/Sites}}"
OUT="${_env_out:-${CLAUDE_HTML_OUT:-$HERE}}"
ROOT="${ROOT/#\~/$HOME}"
OUT="${OUT/#\~/$HOME}"

# Keep the helper app in step with its source: it holds a copy inside it.
[ "$MAC" = true ] && [ -x "$HERE/helper-build.sh" ] &&
  "$HERE/helper-build.sh" "$HERE/Claude HTML.app" --register --if-stale >/dev/null 2>&1 || true

FORCE=false
DELETE=""; PLAN=""; YES=false
OPEN=""; OPENPLAN=""
ONLY=""
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=true ;;
    --delete) DELETE=1 ;;
    --open) OPEN=1 ;;
    --open-plan) OPENPLAN=1 ;;
    --delete-plan) PLAN=1 ;;
    --yes|-y) YES=true ;;
    -h|--help)
      echo "claude-html            rebuild what changed, open the index"
      echo "claude-html --force    rebuild every session"
      echo "claude-html <id>       rebuild one session"
      echo "claude-html --delete <full id>   move a conversation and its history to the Trash"
      echo "claude-html --open <full id>     open that session's project: its server, page or folder"
      exit 0 ;;
    *) ONLY="$arg" ;;
  esac
done

# ── open a project ───────────────────────────────────────────────────
# What "the project" means is decided now rather than when the index was
# built: a port does not exist until its server starts.
if [ -n "$OPEN$OPENPLAN" ]; then
  if [ "$MAC" != true ]; then
    echo "opening a project this way is macOS-only for now" >&2; exit 2
  fi
  if ! printf '%s' "$ONLY" | grep -Eq '^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$'; then
    echo "give the full session id, as it appears in the index's links" >&2
    exit 2
  fi
  MODE=apply; [ -n "$OPENPLAN" ] && MODE=plan
  RESULT="$(run_js "$HERE/open.js" \
    "{\"id\":\"$ONLY\",\"mode\":\"$MODE\",\"root\":\"$ROOT\",\"out\":\"$OUT\"}" 2>&1)" || {
    echo "$RESULT" >&2; exit 1; }
  printf '%s\n' "$RESULT" | awk -F'\t' '{ print $1 ": " $2 }'
  exit 0
fi

# ── delete ──────────────────────────────────────────────────────────
# Needs the full session id: a prefix that happens to match the wrong
# conversation is not a risk worth taking when the result is deletion.
if [ -n "$DELETE$PLAN" ]; then
  if [ "$MAC" != true ]; then
    echo "deleting this way is macOS-only for now: it moves things to the Trash" >&2; exit 2
  fi
  if ! printf '%s' "$ONLY" | grep -Eq '^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$'; then
    echo "give the full session id, as it appears in the index's links" >&2
    exit 2
  fi
  opts() {
    printf '{"id":"%s","mode":"%s","root":"%s","out":"%s"%s}' "$ONLY" "$1" "$ROOT" "$OUT" \
      "${CLAUDE_HTML_TRASH:+,\"trash\":\"$CLAUDE_HTML_TRASH\"}"
  }
  PLANTXT="$(run_js "$HERE/delete.js" "$(opts plan)" 2>&1)" || {
    echo "$PLANTXT" >&2; exit 1; }
  if [ -n "$PLAN" ]; then printf '%s\n' "$PLANTXT"; exit 0; fi

  field() { printf '%s\n' "$PLANTXT" | awk -F'\t' -v k="$1" '$1 == k { print $2; exit }'; }
  ACTION="$(field ACTION)"; TITLE="$(field TITLE)"
  if [ "$ACTION" = refuse ]; then field REASON >&2; exit 1; fi
  if [ "$ACTION" = hide ]; then
    echo "Hide \"$TITLE\" from the index? It lives on claude.ai, and a new export will not bring it back."
  else
    echo "Delete \"$TITLE\"? These move to the Trash:"
    printf '%s\n' "$PLANTXT" | awk -F'\t' '$1 == "ITEM" { printf "  %-30s %s\n", $3, $2 }'
    N="$(field HISTORY)"
    if [ "${N:-0}" -gt 0 ]; then
      echo "  and $N prompt(s) from your up-arrow history (a copy of them goes to the Trash too)"
    fi
  fi
  # Confirmation comes from a person: from --yes, which only the helper passes
  # after its own dialog, or from the terminal. With neither, nothing happens.
  if [ "$YES" != true ]; then
    printf 'Go ahead? [y/N] '
    answer=""
    read -r answer </dev/tty 2>/dev/null || answer=""
    case "$answer" in y|Y|yes|YES) ;; *) echo "nothing changed"; exit 1 ;; esac
  fi
  # Whatever happens next, the index is rebuilt: anything that did move must
  # leave it, even if a later step failed.
  STATUS=0
  RESULT="$(run_js "$HERE/delete.js" "$(opts apply)" 2>&1)" || {
    STATUS=1; echo "$RESULT" >&2; }
  printf '%s\n' "$RESULT" | awk -F'\t' '
    $1 == "DONE" && $4 == "1" { print "hidden from the index" }
    $1 == "DONE" && $4 != "1" { printf "moved %s item(s) to the Trash", $2
                                if ($3 > 0) printf ", took %s prompt(s) out of the history", $3
                                print "" }
    $1 == "FAILED" { print "could not: " $2 > "/dev/stderr" }'
  printf '%s\n' "$RESULT" | grep -q '^FAILED' && STATUS=1
  run_js "$HERE/convert.js" \
    "{\"root\":\"$ROOT\",\"out\":\"$OUT\",\"here\":\"$HERE\"}" >/dev/null 2>&1 || true
  exit "$STATUS"
fi

# The build is one interpreter for every session, so it starts once rather
# than sixty-nine times.
REPORT="$(run_js "$HERE/convert.js" "$(cat <<EOF
{"root":"$ROOT","out":"$OUT","here":"$HERE","force":$FORCE,"only":"$ONLY"}
EOF
)" 2>&1)" || {
  echo "build failed: $REPORT" >&2
  exit 1
}

case "$REPORT" in
  *'"error"'*)
    echo "$REPORT" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p' >&2
    exit 1 ;;
esac

# One line of prose from the report, rather than the JSON.
summary() {
  local built skipped removed sessions errors
  sessions=$(printf '%s' "$REPORT" | sed -n 's/.*"sessions":\([0-9]*\).*/\1/p')
  built=$(printf '%s' "$REPORT" | sed -n 's/.*"built":\([0-9]*\).*/\1/p')
  skipped=$(printf '%s' "$REPORT" | sed -n 's/.*"skipped":\([0-9]*\).*/\1/p')
  removed=$(printf '%s' "$REPORT" | sed -n 's/.*"removed":\([0-9]*\).*/\1/p')
  errors=$(printf '%s' "$REPORT" | grep -o '"error":' | wc -l | tr -d ' ')
  printf '%s session(s): %s built, %s unchanged' "$sessions" "$built" "$skipped"
  [ "${removed:-0}" -gt 0 ] && printf ', %s stale file(s) removed' "$removed"
  printf '\n'
  if [ "${errors:-0}" -gt 0 ]; then
    printf '%s session(s) failed — see the banner on the index, or %s\n' \
      "$errors" "$OUT/.build-errors.json" >&2
  fi
}
summary

# Naming a session means you want that page rebuilt, not the index opened.
[ -n "$ONLY" ] && exit 0

INDEX="$OUT/index.html"
[ -f "$INDEX" ] || exit 0
if command -v open >/dev/null 2>&1; then
  open "$INDEX"
elif command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$INDEX" >/dev/null 2>&1
else
  echo "$INDEX"
fi
