#!/usr/bin/env bash
# Rebuild the conversation pages, and open the index when asked for all of them.
set -uo pipefail
# What it writes holds conversations: for its owner only.
umask 077

# This is normally reached through a symlink on PATH, so follow it back to the
# clone rather than assuming where that is.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
HERE="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Which release this is: answered before anything else is read or run.
VERSION="$(cat "$HERE/VERSION" 2>/dev/null || echo unknown)"
case "${1:-}" in --version|-V) echo "claude-html $VERSION"; exit 0 ;; esac

# Updating: the word after --update says which kind. Worked out before the
# conf is read, because what the environment says about the daily check is
# reported apart from what the conf says.
UPDATE=""; UPDWORD=""; UPDYES=""
_seen=""
for arg in "$@"; do
  if [ -n "$UPDATE" ]; then
    case "$arg" in
      --yes|-y) UPDYES=--yes ;;
      on|off|status|list|--check)
        [ -z "$UPDWORD" ] && [ -z "$_seen" ] || UPDATE=bad; UPDWORD="$arg" ;;
      *) if [ -z "$UPDWORD" ] && [ -z "$_seen" ] &&
            printf '%s' "$arg" | grep -Eqx 'v?[0-9]+\.[0-9]+\.[0-9]+'; then UPDWORD="$arg"
         else UPDATE=bad; fi ;;
    esac
    case "$arg" in --yes|-y) ;; *) _seen=1 ;; esac
  else
    case "$arg" in --update|--upgrade) UPDATE=1 ;; --yes|-y) UPDYES=--yes ;; esac
  fi
done
if [ "$UPDATE" = bad ]; then
  echo "claude-html --update [X.Y.Z|list|status|on|off] [--yes]" >&2
  exit 2
fi
UPD_ENV=unset
[ -n "${CLAUDE_HTML_UPDATE_CHECK+x}" ] && UPD_ENV="set:$CLAUDE_HTML_UPDATE_CHECK"

# Where install.sh was told things live, decided as the hook decides it.
# shellcheck source=lib/conf.sh
. "$HERE/lib/conf.sh"

# One line of the conf, changed where it stands or added: conf.sh's.
conf_line() { ch_conf_set "$@"; }

# ── plan limits, the API budget and the stop rules ───────────────────
# --limits shows and sets them, one conf line at a time; --limits-apply is
# what a claude-html://limits link from the Token usage page reaches: it
# asks in a window first, then writes and rebuilds the pages.
# The pages, built again after a change: as a save builds them, in turn.
rebuild_pages() {
  ch_pick_engine
  # shellcheck source=lib/lock.sh
  . "$HERE/lib/lock.sh"
  _nc=""; ch_lock_take 60 || _nc=":cache false"
  # shellcheck disable=SC2086
  ch_js "$HERE/build/convert.js" "$(ch_js_opts "$HERE" $_nc)" >/dev/null 2>&1
  [ -n "$_nc" ] || ch_lock_release
  ch_private_out "$OUT"
}
case "${1:-}" in
  --limits|--limits-apply)
    set +u
    # shellcheck source=lib/platform.sh
    . "$HERE/lib/platform.sh"
    # shellcheck source=lib/limits.sh
    . "$HERE/lib/limits.sh"
    # shellcheck source=lib/limits-cli.sh
    . "$HERE/lib/limits-cli.sh"
    if [ "$1" = --limits ]; then shift; ch_lim_cli "$@"; exit $?; fi
    [ $# = 2 ] || { echo "claude-html --limits-apply <payload>" >&2; exit 2; }
    ch_lim_apply "$2"; _rc=$?
    [ "$_rc" = 10 ] || exit "$_rc"
    rebuild_pages
    exit 0 ;;
  # Every setting, from lib/settings.tsv: --config shows and changes them,
  # one conf line each; --settings-apply is what a claude-html://settings
  # link from the Settings page reaches: it asks in a window first, then
  # writes, rebuilds the pages, and says where the Settings page is, for
  # the helper or the Linux handler to open it again.
  --config|--settings-apply)
    set +u
    _how="$1"; shift
    # shellcheck source=lib/platform.sh
    . "$HERE/lib/platform.sh"
    # shellcheck source=lib/limits.sh
    . "$HERE/lib/limits.sh"
    # shellcheck source=lib/settings.sh
    . "$HERE/lib/settings.sh"
    if [ "$_how" = --config ]; then ch_set_cli "$@"; _rc=$?
    else
      [ $# = 1 ] || { echo "claude-html --settings-apply <payload>" >&2; exit 2; }
      ch_set_apply "$1"; _rc=$?
    fi
    [ "$_rc" = 10 ] || exit "$_rc"
    rebuild_pages
    [ "$_how" = --config ] || echo "$OUT/settings.html"
    exit 0 ;;
esac

if [ -n "$UPDATE" ]; then
  case "$UPDWORD" in
    on|off)
      # The switch, as --guard is one: its own conf line and nothing else,
      # and what the last check saw (version.sh's ch_update_switched).
      conf_line CLAUDE_HTML_UPDATE_CHECK "$UPDWORD"
      # shellcheck source=lib/version.sh
      . "$HERE/lib/version.sh"
      ch_update_switched "$UPDWORD"
      if [ "$UPDWORD" = off ]; then
        echo "The daily check for new releases is off. claude-html --update on turns it back on."
      else
        echo "The daily check for new releases is on. claude-html --update off turns it off."
      fi
      case "$UPD_ENV" in
        set:*)
          _e="${UPD_ENV#set:}"
          if ch_update_is_off "$_e"; then _eo=off; else _eo=on; fi
          [ "$_eo" = "$UPDWORD" ] ||
            echo "But CLAUDE_HTML_UPDATE_CHECK=$_e in your environment wins over the conf, so here it stays $_eo." ;;
      esac
      exit 0 ;;
  esac
  # The move rewrites this clone, and bash reads a script as it runs it, so
  # the update runs from a copy of itself made outside it.
  _tmp="$(mktemp -d "${TMPDIR:-/tmp}/claude-html-update.XXXXXX")" || exit 1
  cp "$HERE/lib/update.sh" "$HERE/lib/version.sh" "$HERE/lib/lock.sh" "$_tmp/" || { rm -rf "$_tmp"; exit 1; }
  case "$UPDWORD" in
    status|--check) _action=status ;;
    list) _action=list ;;
    *) _action=go ;;
  esac
  _w=""; [ "$_action" = go ] && _w="$UPDWORD"
  bash "$_tmp/update.sh" "$HERE" "$UPD_ENV" "$_action" $_w $UPDYES
  _rc=$?
  rm -rf "$_tmp"
  exit "$_rc"
fi

# The data work - reading transcripts, building pages - is the same bytes
# under osascript and node, and platform.sh picks which runs it, exactly as
# for the hook. The helper app is a Mac's whichever engine that is.
# shellcheck source=lib/platform.sh
. "$HERE/lib/platform.sh"
ch_pick_engine
run_js() { ch_js "$@"; }

# Keep the helper app in step with its source: it holds a copy inside it.
ch_helper_refresh "$HERE" --if-stale || true

# A build keeps a cache of what it parsed, which only one build at a time
# may write. The saves take turns through this lock, so the command waits
# for its turn as well; one that does not get it within a minute builds
# without the cache, reading everything, as every build once did.
# shellcheck source=lib/lock.sh
. "$HERE/lib/lock.sh"
NOCACHE=""
take_lock() {
  if ch_lock_take 60; then trap 'release_lock' EXIT; return 0; fi
  NOCACHE=":cache false"; return 1
}
release_lock() { ch_lock_release; }

FORCE=false
DELETE=""; PLAN=""; YES=false
OPEN=""; OPENPLAN=""
RESUME=""; RESUMEPLAN=""; DOCTOR=""; UPDTERM=""
REDACTCHECK=""; REDACTARCHIVES=""; GUARD=""; GUARDARG=""; GUARDVAL=""; GUARDMORE=""
ONLY=""
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=true ;;
    --delete) DELETE=1 ;;
    --open) OPEN=1 ;;
    --open-plan) OPENPLAN=1 ;;
    --resume-session) RESUME=1 ;;
    --resume-plan) RESUMEPLAN=1 ;;
    --update-terminal) UPDTERM=run ;;
    --update-terminal-plan) UPDTERM=plan ;;
    --delete-plan) PLAN=1 ;;
    --doctor) DOCTOR=1 ;;
    --redact-check) REDACTCHECK=1 ;;
    --redact-archives) REDACTARCHIVES=1 ;;
    --guard) GUARD=1 ;;
    --limits|--limits-apply) echo "claude-html $arg comes first: claude-html --limits [status|add|remove|rules|budget|notify|on|off]" >&2; exit 2 ;;
    --config|--settings-apply) echo "claude-html $arg comes first: claude-html --config [set KEY=VALUE…|unset KEY…|safe|forget-safe [ID…]|edit-list]" >&2; exit 2 ;;
    --yes|-y) YES=true ;;
    -h|--help)
      echo "claude-html            rebuild what changed, open the index"
      echo "claude-html --force    rebuild every session"
      echo "claude-html <id>       rebuild one session"
      echo "claude-html --delete <full id>          move a conversation and its history to the Trash"
      echo "claude-html --open <full id>            open that session's project: its server, page or folder"
      echo "claude-html --resume-session <full id>  reopen that conversation in a terminal"
      echo "claude-html --doctor   what this machine is, and which of its tools does each job"
      echo "claude-html --version  which release this is"
      echo "claude-html --update [X.Y.Z]   go to the newest release, or to that one"
      echo "claude-html --update list      every release there is, newest first"
      echo "claude-html --update status    what is installed and what is out; changes nothing"
      echo "claude-html --update on|off    the daily check for a new release, and its notice"
      echo "claude-html --redact-check     what would be masked as secret, per session and archive; changes nothing"
      echo "claude-html --redact-archives  rewrite the archives that still hold secrets, masked"
      echo "claude-html --guard on|prompt|off|status   stop a secret before it reaches Claude"
      echo "claude-html --guard wait [45s|2m|1m30s|default]   how long its windows wait before Cancel"
      echo "claude-html --limits         plan usage, stop rules, API budget: what is set and the latest figures"
      echo "claude-html --limits add \"fri 20:00 80%\" | remove <n> | rules \"…\"|none"
      echo "claude-html --limits budget day|week|month <dollars> | budget off | budget warn <a> <b>"
      echo "claude-html --limits notify on|off | on|off"
      echo "claude-html --config               every setting: its value, where it comes from, its default"
      echo "claude-html --config set KEY=VALUE … | unset KEY … | forget-safe   (KEY with or without CLAUDE_HTML_)"
      echo "claude-html --config safe | forget-safe [ID…] | edit-list   the guard's safe values, by id; the own list in your editor"
      exit 0 ;;
    *) if [ -n "$GUARD" ] && [ -z "$GUARDARG" ]; then GUARDARG="$arg"
       elif [ -n "$GUARD" ] && [ "$GUARDARG" = wait ]; then
         if [ -z "$GUARDVAL" ]; then GUARDVAL="$arg"; else GUARDMORE=1; fi
       else ONLY="$arg"; fi ;;
  esac
done

# ── what this machine has ────────────────────────────────────────────
# The actions behind the index's links are done with the machine's own
# tools, and which tools those are is worked out here, each time, by
# platform.sh. On macOS they run through osascript whatever engine builds
# the pages: they need the Finder and the helper, which node cannot reach.
actions_setup() {
  ch_detect
  if [ "$CH_OS" = darwin ] && command -v osascript >/dev/null 2>&1; then
    act_js() { osascript -l JavaScript "$@"; }; ACT_MAC=true
  else
    act_js() { ch_node_run "${CH_NODE:-node}" "$@"; }; ACT_MAC=false
  fi
}
full_id() {
  if ! printf '%s' "$ONLY" | grep -Eqx '[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}' ||
     [ "$(printf '%s' "$ONLY" | wc -l | tr -d ' ')" != 0 ]; then
    echo "give the full session id, as it appears in the index's links" >&2
    exit 2
  fi
}

# ── the guard ────────────────────────────────────────────────────────
SETTINGS="$HOME/.claude/settings.json"
GUARD_LIST="$CLAUDE_HTML_REDACT_FILE"
guard_hooks() { grep -cE "/guard\.sh' (prompt|bash)\"" "$SETTINGS" 2>/dev/null || true; }
guard_safe() { grep -c '^[[:space:]]*safe:' "$GUARD_LIST" 2>/dev/null || true; }
guard_line() {
  local what asks n safe
  if ch_is_off "${CLAUDE_HTML_GUARD:-on}"; then what="off"
  elif [ "$(printf '%s' "${CLAUDE_HTML_GUARD:-on}" | tr '[:upper:]' '[:lower:]')" = prompt ]; then what="on for prompts only"
  else what="on"; fi
  if ch_is_off "${CLAUDE_HTML_GUARD_DIALOG:-on}"; then asks="in words, as the next prompt"
  else asks="in a dialog when someone is at the screen"; fi
  n="$(guard_hooks)"; safe="$(guard_safe)"
  printf '%s · %s safe value(s) · hooks %s of 2 in settings.json · asks %s · waits %s · %s\n' \
    "$what" "${safe:-0}" "${n:-0}" "$asks" "$(guard_wait_words)" "$(ch_engine_line | cut -d' ' -f1)"
}
# The guard's line as --doctor and --guard print it, with a wait it ignores.
guard_show() { ch_dl guard "$(guard_line)"; guard_wait_bad; }
# How long the windows wait, as the setting says: platform.sh reads it
# (ch_wait_secs), this only says it.
WAIT_RANGE="from 30 seconds to 60 minutes, written 45, 45s, 2m or 1m30s"
guard_wait_secs() {
  if [ -n "${CLAUDE_HTML_GUARD_WAIT:-}" ] && ch_wait_secs "$CLAUDE_HTML_GUARD_WAIT"; then echo "$_WS"
  else echo "$CH_WAIT_DEFAULT"; fi
}
guard_wait_words() { ch_span "$(guard_wait_secs)"; }
guard_wait_where() {
  case "$CH_GUARD_WAIT_FROM" in
    environment) echo "CLAUDE_HTML_GUARD_WAIT in your environment, which wins over the conf" ;;
    conf) echo "CLAUDE_HTML_GUARD_WAIT in $CONF" ;;
    *) echo "the default" ;;
  esac
}
# A setting that is not a wait is not obeyed in silence: said here, under
# the guard's line, as --limits says a rule it ignores.
guard_wait_bad() {
  [ -n "${CLAUDE_HTML_GUARD_WAIT:-}" ] || return 0
  ch_wait_secs "$CLAUDE_HTML_GUARD_WAIT"; case $? in
    0) return 0 ;;
    2) ch_dl ignored "CLAUDE_HTML_GUARD_WAIT=\"$CLAUDE_HTML_GUARD_WAIT\" ($(guard_wait_where | sed 's/^CLAUDE_HTML_GUARD_WAIT //')): out of range, $WAIT_RANGE; the default, $(ch_span "$CH_WAIT_DEFAULT"), applies" ;;
    *) ch_dl ignored "CLAUDE_HTML_GUARD_WAIT=\"$CLAUDE_HTML_GUARD_WAIT\" ($(guard_wait_where | sed 's/^CLAUDE_HTML_GUARD_WAIT //')): not a wait, $WAIT_RANGE; the default, $(ch_span "$CH_WAIT_DEFAULT"), applies" ;;
  esac
}
guard_wait_show() {
  local where
  if [ -n "${CLAUDE_HTML_GUARD_WAIT:-}" ] && ! ch_wait_secs "$CLAUDE_HTML_GUARD_WAIT"; then where="the default"
  else where="$(guard_wait_where)"; fi
  echo "The guard's windows wait $(guard_wait_words) ($where), then close as Cancel."
  guard_wait_bad
  echo "  $WAIT_RANGE · claude-html --guard wait 2m · claude-html --guard wait default"
}
if [ -n "$GUARD" ]; then
  case "$GUARDARG" in
    on|prompt|off)
      conf_line CLAUDE_HTML_GUARD "$GUARDARG"
      CLAUDE_HTML_GUARD="$GUARDARG"
      guard_show
      [ "$(guard_hooks)" = 2 ] || [ "$GUARDARG" = off ] ||
        echo "the guard's hooks are not in $SETTINGS: run ./install.sh in $HERE to add them" ;;
    wait)
      [ -z "$GUARDMORE$ONLY" ] || { echo "claude-html --guard wait [45s|2m|1m30s|default]" >&2; exit 2; }
      case "$GUARDVAL" in
        "") guard_wait_show ;;
        default)
          ch_conf_unset CLAUDE_HTML_GUARD_WAIT
          [ "$CH_GUARD_WAIT_FROM" = environment ] || CLAUDE_HTML_GUARD_WAIT=""
          echo "The guard's windows wait the default, $(ch_span "$CH_WAIT_DEFAULT"): its line is out of $CONF."
          [ "$CH_GUARD_WAIT_FROM" != environment ] ||
            echo "But CLAUDE_HTML_GUARD_WAIT=$CLAUDE_HTML_GUARD_WAIT in your environment wins over the conf, so here they wait $(guard_wait_words)." ;;
        *)
          # Checked before anything is written: a wait the windows would
          # not obey never reaches the conf.
          ch_wait_secs "$GUARDVAL"; case $? in
            0) ;;
            2) echo "out of range: $GUARDVAL — $WAIT_RANGE; nothing was changed" >&2; exit 2 ;;
            *) echo "not a wait: $GUARDVAL — $WAIT_RANGE; nothing was changed" >&2; exit 2 ;;
          esac
          conf_line CLAUDE_HTML_GUARD_WAIT "$GUARDVAL"
          echo "The guard's windows wait $(ch_span "$_WS"), then close as Cancel: CLAUDE_HTML_GUARD_WAIT in $CONF."
          [ "$CH_GUARD_WAIT_FROM" != environment ] ||
            echo "But CLAUDE_HTML_GUARD_WAIT=$CLAUDE_HTML_GUARD_WAIT in your environment wins over the conf, so here they wait $(guard_wait_words)." ;;
      esac ;;
    status|"")
      guard_show
      # The safe values by rule and date: what a line says after its #.
      _safe="$(grep '^[[:space:]]*safe:' "$GUARD_LIST" 2>/dev/null | sed -n 's/^[^#]*#[[:space:]]*//p')"
      [ -z "$_safe" ] || ch_dl safe "$_safe"
      [ "$(guard_safe)" = 0 ] || ch_dl "" "to forget one: claude-html --config safe gives each an id, claude-html --config forget-safe ID forgets it" ;;
    *) echo "claude-html --guard on|prompt|off|status|wait" >&2; exit 2 ;;
  esac
  exit 0
fi

# The options every data command starts from, plus its own: as JSON, so a
# folder whose name holds a quote or a backslash reaches it whole.
js_opts() { ch_js_opts "$HERE" "$@"; }

if [ -n "$DOCTOR" ]; then
  # Every line through ch_dl (platform.sh), so all of it is laid out alike:
  # what the other scripts give are values, and the labels are put on here.
  actions_setup
  ch_doctor "$VERSION"
  ch_dl_section "claude-html"
  ch_dl update "$(bash "$HERE/lib/update.sh" "$HERE" --doctor-line 2>/dev/null)"
  ch_dl pages "$OUT"
  _open="$(ch_loose_out "$OUT")"
  if [ "$_open" = 0 ]; then ch_dl private "what it wrote there is readable by you alone"
  else ch_dl private "$_open file(s) there readable by others: the next build makes them yours alone"; fi
  ch_dl projects "$ROOT"
  # The archive folders it knows of, and whether git would commit any.
  # shellcheck source=lib/version.sh
  . "$HERE/lib/version.sh"
  _tracked="$( { [ -f "$HOME/.claude/claude-html.archives" ] && cat "$HOME/.claude/claude-html.archives"; echo "$ROOT"
                 for _d in "$ROOT"/*; do echo "$_d"; done; } 2>/dev/null | sort -u |
               while IFS= read -r _d; do [ -n "$_d" ] && ch_archives_tracked "$_d"; done )"
  if [ -z "$_tracked" ]; then ch_dl git "no archive folder would be committed"
  else
    ch_dl git "$(printf '%s\n' "$_tracked" | wc -l | tr -d ' ') archive folder(s) git would commit (a .gitignore holding * in each keeps them out; the next save there writes it):
$(printf '%s\n' "$_tracked" | head -5)"
  fi
  ch_dl_section "Protection"
  # Which secrets are masked, and how many archives still hold some: a line
  # for each, the redaction's and the archives'. Never what the own list says.
  if _ri="$(run_js "$HERE/build/convert.js" "$(js_opts :redactInfo true)" 2>/dev/null)"; then
    ch_dl redact "$(printf '%s\n' "$_ri" | sed -n 1p)"
    _ra="$(printf '%s\n' "$_ri" | sed -n 2p)"
    [ -z "$_ra" ] || ch_dl archives "$_ra"
  else ch_dl redact "could not be checked: $CH_ENGINE_WHY"; fi
  guard_show
  ch_dl_section "Limits"
  # shellcheck source=lib/limits-cli.sh
  ch_dl limits "$( set +u; . "$HERE/lib/limits.sh" && . "$HERE/lib/limits-cli.sh" && ch_lim_doctor 2>/dev/null)"
  exit 0
fi

# ── secrets ─────────────────────────────────────────────────────────
# A look, which reads everything and writes nothing, and the one command
# that rewrites archives: they are permanent, and a build only ever reads
# them. It takes its turn with the saves, and then builds, so the pages
# say the archives are clean.
if [ -n "$REDACTCHECK" ]; then
  run_js "$HERE/build/convert.js" "$(js_opts :redactCheck true)" || exit 1
  exit 0
fi
if [ -n "$REDACTARCHIVES" ]; then
  if ! take_lock; then
    echo "a save is still running; try again in a moment — nothing was rewritten" >&2
    exit 1
  fi
  RESULT="$(run_js "$HERE/build/convert.js" "$(js_opts :redactArchives true)")" || {
    echo "$RESULT" >&2; exit 1; }
  printf '%s\n' "$RESULT"
  run_js "$HERE/build/convert.js" "$(js_opts)" >/dev/null 2>&1 || true
  release_lock
  case "$RESULT" in *"could not rewrite"*) exit 1 ;; esac
  exit 0
fi

# ── resume a conversation ────────────────────────────────────────────
# The launcher convert.js wrote for it, opened as a double-click would: on
# macOS by Terminal, on Linux in the terminal platform.sh found. Nothing
# from the link is run; the id only picks which launcher, and only one the
# manifest knows and that can be resumed.
if [ -n "$RESUME$RESUMEPLAN" ]; then
  full_id
  actions_setup
  EXT=.sh; [ "$ACT_MAC" = true ] && EXT=.command
  RESULT="$(act_js "$HERE/actions/resume.js" "$(ch_json_obj id "$ONLY" out "$OUT" ext "$EXT")" 2>&1)" || {
    echo "$RESULT" >&2; exit 1; }
  LAUNCHER="$(printf '%s\n' "$RESULT" | sed -n 's/^LAUNCHER	//p')"
  COMMAND="$(printf '%s\n' "$RESULT" | sed -n 's/^COMMAND	//p')"
  # Both ways go through ch_run, so the plan prints exactly the command the
  # real thing would run, and runs nothing.
  if [ "$ACT_MAC" = true ]; then
    HOW="Terminal"; set -- ch_run /usr/bin/open "$LAUNCHER"
  elif [ -n "$CH_TERM" ]; then
    HOW="$CH_TERM"; set -- ch_term_run sh "$LAUNCHER"
  else
    # No terminal to open (a server, an ssh session): say what to type.
    echo "run: $COMMAND"; exit 0
  fi
  if [ -n "$RESUMEPLAN" ]; then
    printf 'launcher: %s\nopens with: %s\ncommand: %s\n' "$LAUNCHER" "$HOW" "$(CH_DRY=1 "$@")"
    exit 0
  fi
  "$@" >/dev/null 2>&1 || { echo "could not open $HOW for $LAUNCHER" >&2; exit 1; }
  # Run from the helper or a desktop link, where nothing is visible if it goes
  # wrong, so it leaves a note beside .last-open saying what it did.
  printf '%s  %s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$HOW" "$LAUNCHER" > "$OUT/.last-resume" 2>/dev/null || true
  echo "resumed in $HOW: $LAUNCHER"
  exit 0
fi

# ── the index's run button for an update ─────────────────────────────
# claude-html://update, from the helper or the Linux handler: this clone's
# own command, --update, through a launcher it writes each time, in a
# terminal: Terminal on macOS, which opens a .command, and on Linux the
# terminal platform.sh found. When the update ends, the window stays, as an
# ordinary shell - as a resume launcher's does.
if [ -n "$UPDTERM" ]; then
  actions_setup
  CLI="$HERE/claude-html"
  if [ "$ACT_MAC" = true ]; then
    LAUNCHER="$HOME/.claude/.claude-html-update.command"
    TAIL='s=${SHELL:-}; { [ -f "$s" ] && [ -x "$s" ]; } || s=/bin/zsh
exec "$s" -l'
    HOW="Terminal"; set -- ch_run /usr/bin/open "$LAUNCHER"
  elif [ -n "$CH_TERM" ]; then
    LAUNCHER="$HOME/.claude/.claude-html-update.sh"
    TAIL='s=${SHELL:-}; { [ -f "$s" ] && [ -x "$s" ]; } || s=/bin/bash; { [ -f "$s" ] && [ -x "$s" ]; } || s=/bin/sh
exec "$s" -i'
    HOW="$CH_TERM"; set -- ch_term_run sh "$LAUNCHER"
  else
    echo "run: $(ch_quote "$CLI") --update"; exit 0
  fi
  if [ "$UPDTERM" = plan ]; then
    printf 'launcher: %s\nopens with: %s\ncommand: %s\n' "$LAUNCHER" "$HOW" "$(CH_DRY=1 "$@")"
    exit 0
  fi
  # Any web page can open the link, as often as it likes: one window a
  # minute at most, and the update itself asks before it moves anything.
  if [ -n "$(find "$LAUNCHER" -mmin -1 2>/dev/null)" ]; then
    echo "an update window was opened less than a minute ago; nothing was opened" >&2; exit 1
  fi
  TO="the newest release"
  # shellcheck source=lib/version.sh
  if . "$HERE/lib/version.sh" 2>/dev/null && ch_update_read && [ "$CH_UP_HERE" = "$HERE" ] &&
     [ -n "$CH_UP_NEWEST" ]; then TO="$CH_UP_NEWEST"; fi
  mkdir -p "$(dirname "$LAUNCHER")" &&
  printf '#!/bin/sh\n# Written by claude-html for the run button on the index: asks, the update,\n# then your shell, so what it said stays on the screen.\nprintf %s\nread -r answer\ncase "$answer" in y|Y|yes|YES) %s --update ;; *) echo "nothing was changed" ;; esac\necho\n%s\n' \
    "$(ch_quote "Update claude-html $VERSION -> $TO? [y/N] ")" "$(ch_quote "$CLI")" "$TAIL" > "$LAUNCHER" && chmod +x "$LAUNCHER" ||
    { echo "could not write $LAUNCHER" >&2; exit 1; }
  "$@" >/dev/null 2>&1 || { echo "could not open $HOW for the update" >&2; exit 1; }
  echo "update opened in $HOW"
  exit 0
fi

# ── open a project ───────────────────────────────────────────────────
# What "the project" means is decided now rather than when the index was
# built: a port does not exist until its server starts.
if [ -n "$OPEN$OPENPLAN" ]; then
  full_id
  actions_setup
  MODE=apply; [ -n "$OPENPLAN" ] && MODE=plan
  # Nothing here can open anything (a server): it says where, and stops.
  if [ "$ACT_MAC" != true ] && [ -z "$CH_OPENER" ]; then MODE=plan; fi
  RESULT="$(act_js "$HERE/actions/open.js" \
    "$(ch_json_obj id "$ONLY" mode "$MODE" root "$ROOT" out "$OUT" opener "$CH_OPENER")" 2>&1)" || {
    echo "$RESULT" >&2; exit 1; }
  printf '%s\n' "$RESULT" | awk -F'\t' '{ print $1 ": " $2 }'
  exit 0
fi

# ── delete ──────────────────────────────────────────────────────────
# Needs the full session id: a prefix that happens to match the wrong
# conversation is not a risk worth taking when the result is deletion.
if [ -n "$DELETE$PLAN" ]; then
  full_id
  actions_setup
  # The trash method rides along for node; the macOS side has the Finder's.
  opts() {
    if [ -n "${CLAUDE_HTML_TRASH:-}" ]; then
      ch_json_obj id "$ONLY" mode "$1" root "$ROOT" out "$OUT" trashMethod "$CH_TRASH" trash "$CLAUDE_HTML_TRASH"
    else
      ch_json_obj id "$ONLY" mode "$1" root "$ROOT" out "$OUT" trashMethod "$CH_TRASH"
    fi
  }
  PLANTXT="$(act_js "$HERE/actions/delete.js" "$(opts plan)" 2>&1)" || {
    echo "$PLANTXT" >&2; exit 1; }
  if [ -n "$PLAN" ]; then printf '%s\n' "$PLANTXT"; exit 0; fi

  field() { printf '%s\n' "$PLANTXT" | awk -F'\t' -v k="$1" '$1 == k { print $2; exit }'; }
  ACTION="$(field ACTION)"; TITLE="$(field TITLE)"
  if [ "$ACTION" = refuse ]; then field REASON >&2; exit 1; fi
  if [ "$ACTION" = hide ]; then
    echo "Hide \"$TITLE\" from the index? It lives on claude.ai, and a new export will not bring it back."
  else
    echo "Delete \"$TITLE\"? These move to the Trash:"
    printf '%s\n' "$PLANTXT" | awk -F'\t' '$1 == "ITEM" { printf "  %-30s %s\n", $3, $2 }'
    N="$(field HISTORY)"
    if [ "${N:-0}" -gt 0 ]; then
      echo "  and $N prompt(s) from your up-arrow history (a copy of them goes to the Trash too)"
    fi
  fi
  # Confirmation comes from a person: from --yes, which only the helper passes
  # after its own dialog, or from the terminal. With neither, nothing happens.
  if [ "$YES" != true ]; then
    printf 'Go ahead? [y/N] '
    answer=""
    read -r answer </dev/tty 2>/dev/null || answer=""
    case "$answer" in y|Y|yes|YES) ;; *) echo "nothing changed"; exit 1 ;; esac
  fi
  # Whatever happens next, the index is rebuilt: anything that did move must
  # leave it, even if a later step failed.
  STATUS=0
  RESULT="$(act_js "$HERE/actions/delete.js" "$(opts apply)" 2>&1)" || {
    STATUS=1; echo "$RESULT" >&2; }
  printf '%s\n' "$RESULT" | awk -F'\t' '
    $1 == "DONE" && $4 == "1" { print "hidden from the index" }
    $1 == "DONE" && $4 != "1" { printf "moved %s item(s) to the Trash", $2
                                if ($3 > 0) printf ", took %s prompt(s) out of the history", $3
                                print "" }
    $1 == "FAILED" { print "could not: " $2 > "/dev/stderr" }'
  printf '%s\n' "$RESULT" | grep -q '^FAILED' && STATUS=1
  take_lock || true
  # shellcheck disable=SC2086
  run_js "$HERE/build/convert.js" "$(js_opts $NOCACHE)" >/dev/null 2>&1 || true
  exit "$STATUS"
fi

# The build is one interpreter for every session, so it starts once rather
# than sixty-nine times.
take_lock || echo "a save is still running; building without the cache" >&2
# shellcheck disable=SC2086
REPORT="$(run_js "$HERE/build/convert.js" "$(js_opts :force "$FORCE" only "$ONLY" $NOCACHE)" 2>&1)" || {
  echo "build failed: $REPORT" >&2
  exit 1
}
release_lock
ch_private_out "$OUT"

case "$REPORT" in
  *'"error"'*)
    echo "$REPORT" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p' >&2
    exit 1 ;;
esac

# One line of prose from the report, rather than the JSON.
summary() {
  local built skipped removed sessions errors redacted dirty
  sessions=$(printf '%s' "$REPORT" | sed -n 's/.*"sessions":\([0-9]*\).*/\1/p')
  built=$(printf '%s' "$REPORT" | sed -n 's/.*"built":\([0-9]*\).*/\1/p')
  skipped=$(printf '%s' "$REPORT" | sed -n 's/.*"skipped":\([0-9]*\).*/\1/p')
  removed=$(printf '%s' "$REPORT" | sed -n 's/.*"removed":\([0-9]*\).*/\1/p')
  errors=$(printf '%s' "$REPORT" | grep -o '"error":' | wc -l | tr -d ' ')
  redacted=$(printf '%s' "$REPORT" | sed -n 's/.*"redacted":\([0-9]*\).*/\1/p')
  dirty=$(printf '%s' "$REPORT" | sed -n 's/.*"unredactedArchives":\([0-9]*\).*/\1/p')
  printf '%s session(s): %s built, %s unchanged' "$sessions" "$built" "$skipped"
  [ "${removed:-0}" -gt 0 ] && printf ', %s stale file(s) removed' "$removed"
  printf '\n'
  [ "${redacted:-0}" -gt 0 ] && printf '%s secret(s) masked in what was built\n' "$redacted"
  [ "${dirty:-0}" -gt 0 ] &&
    printf '%s archive(s) still hold secrets the pages hide: claude-html --redact-archives rewrites them\n' "$dirty"
  if [ "${errors:-0}" -gt 0 ]; then
    printf '%s session(s) failed — see the banner on the index, or %s\n' \
      "$errors" "$OUT/.build-errors.json" >&2
  fi
}
summary

# A newer release, as the last daily check saw it: one line, on stderr.
# shellcheck source=lib/version.sh
if [ -f "$HERE/lib/version.sh" ] && . "$HERE/lib/version.sh" && ch_update_notice "$HERE" "$VERSION"; then
  echo "claude-html $CH_UP_NOTICE is out · update with claude-html --update" >&2
fi

# Naming a session means you want that page rebuilt, not the index opened.
[ -n "$ONLY" ] && exit 0

INDEX="$OUT/index.html"
[ -f "$INDEX" ] || exit 0
ch_detect
ch_open_file "$INDEX" || echo "$INDEX"
